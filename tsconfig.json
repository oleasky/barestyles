{
    "compilerOptions": {
      "module": "CommonJS",
      "target": "ESNext",
      "strict": true,
      "esModuleInterop": true,
      "declaration": true, // Generate type declarations for your plugin
      "outDir": "./dist", // Output compiled files here
      "declarationDir": "./dist",
      "skipLibCheck": true,
      "allowSyntheticDefaultImports": true,
    },
    "include": ["src/**/*.ts"],
    "exclude": ["node_modules", "dist"],
     /* Path Aliases */
     "baseUrl": ".",
     "paths": {
       "@/*": ["./src/*"]
     }
}
  